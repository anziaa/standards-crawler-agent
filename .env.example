# ---------------------------------------------------------------------------
# standards-crawler-agent 环境变量模板
#
# 全部可选：一项都不填也能跑（退化为「规则型下载策略 + 浏览器搜索」）。
# 复制成 .env 后按需填写：   Copy-Item .env.example .env
#
# .env 不会进入版本库（见 .gitignore），密钥只留在本地。
# ---------------------------------------------------------------------------


# === 大模型：可选的下载规划器与候选选择器 ==================================
# 只有设了 OPENAI_API_KEY 才会启用大模型；否则整条流程走规则型策略。
# 本项目按 OpenAI 兼容接口调用，默认端点指向阿里云百炼（DashScope）。
OPENAI_API_KEY=

# 注意：本项目 **不读取** DASHSCOPE_API_KEY。
# 默认端点虽然是 DashScope，但密钥统一从上面的 OPENAI_API_KEY 读。
# 只填 DASHSCOPE_API_KEY 会静默退化成规则型策略（不报错），所以别填错位置。
# DASHSCOPE_API_KEY=


# === 大模型：端点与模型 ====================================================
# 端点两个变量取其一即可。代码优先读 OPENAI_BASE_URL，没设时才回退 OPENAI_API_BASE。
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 规划器模型：决定「用哪种下载方式」打开页面。
OPENAI_MODEL=qwen-plus

# 候选选择器模型：决定「候选池里先看哪一个」，只输出下标，可以便宜地跑。
# 设为 off 或 none 可关闭它（用于 A/B 对比）。
OPENAI_CHOOSER_MODEL=qwen-turbo

# 单次调用超时（秒）与重试次数。
#
# 约束：OPENAI_TIMEOUT x (OPENAI_MAX_RETRIES + 1) 必须明显小于批量的 --timeout。
# 上游偶发停顿能把一次决策拖过 120 秒，若两者相等，整次尝试会被白杀且没机会换候选。
# 默认 40 x 2 = 80 秒，留 40 秒给「换候选再试一次」；实测正常调用在 5~12 秒之间。
OPENAI_TIMEOUT=40
OPENAI_MAX_RETRIES=1


# === 搜索引擎 ==============================================================
# 设了 SERPAPI_API_KEY 就用结构化搜索 API；不设则用 Playwright 直接抓搜索页
# （更容易被风控、拿到兜底页，批量跑建议配上）。
SERPAPI_API_KEY=

# 浏览器搜索使用的引擎：bing（默认）/ baidu / google
# SEARCH_ENGINE=bing


# === 浏览器 ================================================================
# 1 / true / yes / on / headless  -> 无头（默认：不弹窗、不抢焦点）
# 0 / false / no / off / headed   -> 有头（会真的弹出窗口并抢焦点）
#
# 取值写错（例如 Flase）会当场报错，不会静默退回默认值。
# 该变量对单任务、batch、sheet_crawl 都生效；--headed 只作用于单任务 CLI。
# BROWSER_HEADLESS=1


# === 编制依据表（sheet_crawl / report 用）====================================
# 表是各人自己的业务文件，不进版本库。默认值是相对当前工作目录的「编制依据汇总表.xlsx」
# 与工作表名「编制依据」，所以要用这两个模块就得在这里指对（或用 --source / --sheet）。
SHEET_SOURCE=编制依据汇总表.xlsx
SHEET_NAME=编制依据
